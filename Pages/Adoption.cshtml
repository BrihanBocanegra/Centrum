@page
@model AdoptionModel
@{
    ViewData["Title"] = "Adopción";
}

<h1>Adopción de servicios de Microsoft 365</h1>

<form method="get" class="mb-3 d-flex align-items-center gap-2">
    <label for="Period" class="form-label mb-0">Periodo:</label>
    <select id="Period" name="Period" class="form-select w-auto" onchange="this.form.submit()">
        @foreach (var p in AdoptionModel.Periods)
        {
            <option value="@p" selected="@(p == Model.Period)">Últimos @p.Substring(1) días</option>
        }
    </select>
    @if (Model.RefreshDate is not null)
    {
        <small class="text-muted">Datos al @Model.RefreshDate</small>
    }
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Services.Count == 0)
{
    <div class="alert alert-warning">No hay datos de adopción disponibles para este tenant.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Servicio</th><th class="text-end">Activos</th><th class="text-end">Inactivos</th><th style="width:40%">Adopción</th></tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Services)
        {
            <tr>
                <td>@s.Name</td>
                <td class="text-end">@s.Active</td>
                <td class="text-end">@s.Inactive</td>
                <td>
                    <div class="progress" role="progressbar" aria-valuenow="@s.Percentage.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width:@s.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">@s.Percentage.ToString("0.#")%</div>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
